def top_k_frequent(lst, k):
    if k <= 0:
        raise ValueError
    result=[]
    for x in lst:
        if x not in result:
            result.append(x)
    result.sort(key=lambda x: (-lst.count(x), x))
    return result[:k]
print(top_k_frequent([1, 1, 2, 2, 3],2))
print(top_k_frequent([3, 3, 1, 1, 2, 2],3))
print(top_k_frequent([], 1))
print(top_k_frequent([1, 2], 5))
print(top_k_frequent([1], 0))
